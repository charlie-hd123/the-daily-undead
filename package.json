{
  "name": "the-daily-undead",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8080",
    "start:leaderboards": "npx wrangler@latest dev --config worker/wrangler.leaderboards-local.jsonc --port 8788",
    "start:profiles": "npx wrangler@latest dev --config worker/wrangler.profiles-local.jsonc --port 8788",
    "db:profiles": "npx wrangler@latest d1 migrations apply daily-undead-profiles-local --local --config worker/wrangler.profiles-local.jsonc",
    "generate:worker-catalog": "node scripts/generate-worker-catalog.js",
    "test": "node --test"
  }
}
