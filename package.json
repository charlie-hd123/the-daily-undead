{
  "name": "the-daily-undead",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:auth-vendor": "esbuild node_modules/@supabase/supabase-js/dist/index.mjs --bundle --format=esm --platform=browser --minify --outfile=js/vendor/supabase.js",
    "migrate:auth-users": "node scripts/migrate-clerk-users-to-supabase.mjs",
    "start": "python3 -m http.server 8080",
    "dev": "node scripts/dev.mjs",
    "build:staging": "node scripts/build-staging.mjs",
    "validate:launch": "node scripts/validate-production-launch.mjs",
    "build:production": "node scripts/build-site.mjs production",
    "build:local": "node scripts/build-site.mjs local --working",
    "release:status": "node scripts/release.mjs status",
    "release:sync": "node scripts/release.mjs sync",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:check": "node scripts/release.mjs check",
    "release:smoke": "node scripts/release.mjs smoke",
    "release:promote": "node scripts/release.mjs promote",
    "release:verify-live": "node scripts/release.mjs verify-live",
    "deploy:staging": "node scripts/release.mjs stage",
    "generate:worker-catalog": "node scripts/generate-worker-catalog.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "4.151.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
