{
  "name": "daily-undead-staging-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-12",
  "workers_dev": true,
  "preview_urls": true,
  "triggers": {
    "crons": [
      "0 */12 * * *"
    ]
  },
  "vars": {
    "DEPLOYMENT_ENVIRONMENT": "staging",
    "STAGING_FIXTURES": "1",
    "ALLOWED_ORIGINS": "https://daily-undead-staging.pages.dev",
    "SUPABASE_ISSUER": "https://zsnnvzhimtlhpvwhwxpy.supabase.co/auth/v1",
    "SUPABASE_HEARTBEAT_URL": "https://zsnnvzhimtlhpvwhwxpy.supabase.co/functions/v1/project-heartbeat",
    "BLOOD_TIES_DEMO": "1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daily-undead-staging",
      "database_id": "f664fd9b-7adc-4d60-87dd-aaacb0fb5547",
      "migrations_dir": "migrations"
    }
  ]
}
